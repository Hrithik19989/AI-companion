# Ollama -> OpenAI-compatible endpoint
OPENAI_BASE_URL=http://localhost:11434/v1

# Ollama does not require a real OpenAI key,
# but the app expects this env var to exist.
OPENAI_API_KEY=ollama

# Use a model you have installed in Ollama (from http://localhost:11434/v1/models)
OPENAI_MODEL=qwen2.5-coder:1.5b

